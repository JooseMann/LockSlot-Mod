{
	"schemaVersion": 1,
	"id": "lock-slot",
	"version": "${version}",
	"name": "Lock Slot",
	"description": "A mod that allows you to lock an inventory slot, so that items cannot be accidentally thrown.",
	"authors": [
		"JooseMann"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/lock-slot/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.joosemann.lockslot.LockSlot"
		],
		"fabric-datagen": [
			"net.joosemann.lockslot.LockSlotDataGenerator"
		]
	},
	"mixins": [
		"lock-slot.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}